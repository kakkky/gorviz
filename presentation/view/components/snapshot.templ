package components

import "strconv"

type SnapshotViewModel struct {
	At             string
	Window         string
	ProcCount      int
	ThreadCount    int
	GoroutineCount int
	Created        int
	Exited         int
	States         []GoroutineStateViewModel
	Lanes          []ProcLaneViewModel
	History        SparklineViewModel
	TopOrigins     []OriginCountViewModel
	LeakCheck      string
	LeakSuspects   []LeakSuspectViewModel
}

type GoroutineStateViewModel struct {
	Label   string
	Count   int
	Percent string
	Class   string
}

type ProcLaneViewModel struct {
	Proc        string
	Utilization string
	Cells       []LaneCellViewModel
}

type LaneCellViewModel struct {
	Style string
	Title string
}

type SparklineViewModel struct {
	Points  string
	Min     int
	Max     int
	Samples int
}

type OriginCountViewModel struct {
	Count  int
	Origin string
}

type LeakSuspectViewModel struct {
	Confirmed   bool
	Count       int
	Growth      string
	LongestWait string
	Origin      string
}

templ Snapshot(vm SnapshotViewModel) {
	<section class="panel">
		<h2>Overview <span class="muted">{ vm.At }</span></h2>
		<div class="stats">
			@stat("P (GOMAXPROCS)", strconv.Itoa(vm.ProcCount))
			@stat("M seen in trace", strconv.Itoa(vm.ThreadCount))
			@stat("G total", strconv.Itoa(vm.GoroutineCount))
			@stat("G created / exited", "+"+strconv.Itoa(vm.Created)+" / -"+strconv.Itoa(vm.Exited))
			@stat("trace window", vm.Window)
		</div>
		<div class="states">
			for _, s := range vm.States {
				<div class={ s.Class } style={ templ.SafeCSS("width:" + s.Percent) } title={ s.Label + ": " + strconv.Itoa(s.Count) }></div>
			}
		</div>
		<div class="legend">
			for _, s := range vm.States {
				<span><i class={ s.Class }></i>{ s.Label } { strconv.Itoa(s.Count) }</span>
			}
		</div>
	</section>
	<section class="panel">
		<h2>P timeline <span class="muted">color = goroutine, brightness = busy ratio</span></h2>
		<div class="lanes">
			for _, lane := range vm.Lanes {
				<span>{ lane.Proc }</span>
				<div class="lane">
					for _, c := range lane.Cells {
						<span style={ templ.SafeCSS(c.Style) } title={ c.Title }></span>
					}
				</div>
				<span class="muted">{ lane.Utilization }</span>
			}
		</div>
	</section>
	<div class="grid-2">
		<section class="panel">
			<h2>Goroutine count <span class="muted">last { strconv.Itoa(vm.History.Samples) } polls, { strconv.Itoa(vm.History.Min) }–{ strconv.Itoa(vm.History.Max) }</span></h2>
			<svg class="sparkline" viewBox="0 0 100 100" preserveAspectRatio="none">
				<polyline points={ vm.History.Points }></polyline>
			</svg>
			<h2>Top origins</h2>
			<table>
				<tr><th>count</th><th>created by</th></tr>
				for _, o := range vm.TopOrigins {
					<tr><td>{ strconv.Itoa(o.Count) }</td><td class="origin">{ o.Origin }</td></tr>
				}
			</table>
		</section>
		<section class="panel">
			<h2>Leak suspects <span class="muted">runtime leak check: { vm.LeakCheck }</span></h2>
			if len(vm.LeakSuspects) == 0 {
				<p class="muted">none</p>
			} else {
				<table>
					<tr><th></th><th>count</th><th>growth</th><th>longest wait</th><th>created by</th></tr>
					for _, s := range vm.LeakSuspects {
						<tr>
							<td>
								if s.Confirmed {
									<span class="badge leaked">LEAKED</span>
								} else {
									<span class="badge suspect">SUSPECT</span>
								}
							</td>
							<td>{ strconv.Itoa(s.Count) }</td>
							<td>{ s.Growth }</td>
							<td>{ s.LongestWait }</td>
							<td class="origin">{ s.Origin }</td>
						</tr>
					}
				</table>
			}
		</section>
	</div>
}

templ stat(label, value string) {
	<div class="stat">
		<div class="value">{ value }</div>
		<div class="label">{ label }</div>
	</div>
}
