{
  "family": "api",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "1024",
  "memory": "2048",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "example.com/api:latest",
      "essential": true,
      "environment": [{"name": "PPROF_ADDR", "value": "localhost:6060"}],
      "dockerLabels": {"gorviz.kakkky.dev/observe": "true"}
    },
    {
      "name": "gorviz-agent",
      "image": "ghcr.io/kakkky/gorviz:latest",
      "essential": false,
      "cpu": 128,
      "memory": 160,
      "command": ["gorviz-agent", "-name", "api", "-target", "http://localhost:6060", "-agent-addr", "gorviz-server.internal:7071", "-trace-buffer-mib", "64"]
    }
  ]
}
