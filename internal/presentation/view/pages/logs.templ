package pages

import (
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/presentation/view/components"
	"github.com/kakkky/gorviz/internal/presentation/view/layout"
	"github.com/kakkky/gorviz/internal/presentation/view/partials"
)

type LogsViewModel struct {
	TargetURL string
	Query     string
	Level     string
	Levels    []string
	Logs      components.LogListViewModel
}

templ Logs(vm LogsViewModel) {
	@layout.Base(vm.TargetURL, "Logs") {
		<div class="logs-page">
			<section class="panel logs-list">
				<h2>Logs</h2>
				<form method="get" action="/logs" class="log-filter" data-turbo-frame={ partials.LogListFrameID }>
					<input type="search" name="q" value={ vm.Query } placeholder="search text"/>
					<select name="level">
						<option value="">all levels</option>
						for _, lv := range vm.Levels {
							<option value={ lv } selected?={ lv == vm.Level }>{ lv }</option>
						}
					</select>
					<button type="submit">search</button>
				</form>
				@turbo.Frame(partials.LogListFrameID) {
					@components.LogList(vm.Logs)
				}
			</section>
			@turbo.Frame(components.LogReplayFrameID) {
				<section class="panel muted">Click a log line to replay the scheduler around it.</section>
			}
		</div>
	}
}
