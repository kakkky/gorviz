package components

import (
	"github.com/kakkky/hotwire-go/stimulus"

	"github.com/kakkky/gorviz/internal/assets"
)

// GMPReplayViewModel の Live が true なら、SSE で DataID の要素に次々と窓が届く (Live 画面)。
// false なら InitialJSON の窓 1 つだけを再生する (Explore でログをクリックしたとき)
type GMPReplayViewModel struct {
	DataID      string
	Live        bool
	InitialJSON string
	Title       string
}

// GMPReplay は再生の操作部と描画先。SSE で中身を差し替えられるのは DataID の要素だけで、
// 再生中の状態を持つ controller の要素そのものは差し替えない
templ GMPReplay(vm GMPReplayViewModel) {
	<section class="panel replay" { stimulus.AttrControllers(assets.GMPReplayController.Name)... }>
		<h2>
			if vm.Title != "" {
				{ vm.Title }
			} else {
				GMP replay
			}
		</h2>
		<p class="muted">click a goroutine to open it</p>
		<div class="replay-controls">
			<button type="button" { stimulus.AttrTargets(assets.GMPReplayController.Name, "play")... } { stimulus.AttrActions("click->" + assets.GMPReplayController.Name + "#togglePlay")... }>pause</button>
			<select { stimulus.AttrTargets(assets.GMPReplayController.Name, "speed")... }>
				<option value="0.005">0.005x</option>
				<option value="0.01">0.01x</option>
				<option value="0.02" selected>0.02x</option>
				<option value="0.05">0.05x</option>
				<option value="0.2">0.2x</option>
			</select>
			<input type="range" min="0" step="1000" class="seek" { stimulus.AttrTargets(assets.GMPReplayController.Name, "seek")... } { stimulus.AttrActions("input->" + assets.GMPReplayController.Name + "#seek")... }/>
			<span class="clock" { stimulus.AttrTargets(assets.GMPReplayController.Name, "clock")... }></span>
			if vm.Live {
				<label><input type="checkbox" checked { stimulus.AttrTargets(assets.GMPReplayController.Name, "live")... }/> follow latest window</label>
				<button type="button" hidden { stimulus.AttrTargets(assets.GMPReplayController.Name, "pending")... } { stimulus.AttrActions("click->" + assets.GMPReplayController.Name + "#loadLatest")... }>new window ready — load</button>
			}
		</div>
		<div class="replay-stage" { stimulus.AttrTargets(assets.GMPReplayController.Name, "stage")... }>
			<p class="muted">waiting for the first trace window...</p>
		</div>
		<p class="muted replay-note">
			The local / global run queues are inferred from the execution trace: a goroutine readied by a P is placed on that P's local run queue, and one descheduled by preemption, yield or a syscall without P is placed on the global run queue. runnext is not distinguished.
			<span class="error" { stimulus.AttrTargets(assets.GMPReplayController.Name, "note")... }></span>
		</p>
		<pre class="replay-log" { stimulus.AttrTargets(assets.GMPReplayController.Name, "log")... }></pre>
		<div id={ vm.DataID } hidden>
			if vm.InitialJSON != "" {
				@GMPReplayData(vm.InitialJSON)
			}
		</div>
	</section>
}

templ GMPReplayData(json string) {
	@templ.Raw(`<script type="application/json" data-` + assets.GMPReplayController.Name + `-target="window">` + json + `</script>`)
}
