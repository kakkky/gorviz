package layout

import (
	"github.com/kakkky/hotwire-go/stimulus"
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/assets"
)

// BaseViewModel は全画面の外枠。見出しのピルはセッションで動かしているアプリと、その状態
type BaseViewModel struct {
	Title   string
	App     string
	State   string
	Running bool
	Tabs    []LinkViewModel
}

type LinkViewModel struct {
	Label  string
	URL    string
	Active bool
}

func controllerPaths() []string {
	out := make([]string, 0, len(assets.Controllers))
	for _, c := range assets.Controllers {
		out = append(out, assets.Versioned(c.Path))
	}
	return out
}

templ head(title string) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title } · gorviz</title>
		<link rel="stylesheet" href={ assets.Versioned(assets.StylesheetPath) } data-turbo-track="reload"/>
		// 古いブラウザは module の読み込み開始後に出た import map を無視するので、import map (ScriptLoad) を module より先に出す
		@stimulus.ScriptLoad(controllerPaths()...)
		<script type="module" src={ assets.Versioned(assets.IslandsPath) } data-turbo-track="reload"></script>
		@turbo.ScriptImport()
	</head>
}

templ Base(vm BaseViewModel) {
	<!DOCTYPE html>
	<html lang="en">
		@head(vm.Title)
		<body>
			<header class="app">
				<h1><a href="/">gorviz</a></h1>
				<span class="app-switch" title="the app of this session">
					<span class={ "app-dot", templ.KV("connected", vm.Running) }></span>
					<strong class="mono">{ vm.App }</strong>
					<span class="sep">·</span>
					<span class="faint">{ vm.State }</span>
				</span>
				<nav>
					for _, t := range vm.Tabs {
						<a href={ templ.SafeURL(t.URL) } class={ templ.KV("active", t.Active) }>{ t.Label }</a>
					}
				</nav>
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}
