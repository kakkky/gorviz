package components

templ CertaintyBadge(certainty string, note string) {
	if certainty == "FACT" {
		<span class="badge fact" title={ note }>FACT</span>
	} else if certainty != "" {
		<span class="badge inference" title={ note }>INFERENCE</span>
	}
}

templ CauseBadge(cause string) {
	if cause != "" {
		<span class={ "badge", "cause", "cause-" + cause }>{ cause }</span>
	}
}

templ KindBadge(kind string) {
	<span class="badge kind">{ kind }</span>
}

templ OngoingDot(ongoing bool) {
	if ongoing {
		<span class="active-dot" title="an occurrence is still going on in some instance"></span>
	}
}

templ SectionTitle(title, desc string) {
	<h3 class="section-title">{ title } <span>{ desc }</span></h3>
}

// AgentIcon は gorviz の agent の goroutine に付ける印。GMP の再生のチップと同じ形
templ AgentIcon() {
	<svg class="agent-icon" viewBox="0 0 16 16" width="12" height="12" aria-label="gorviz agent" role="img">
		<circle cx="8" cy="8" r="1.6" fill="currentColor"></circle>
		<path d="M5.2 5.2a4 4 0 0 0 0 5.6M10.8 5.2a4 4 0 0 1 0 5.6M3 3a7 7 0 0 0 0 10M13 3a7 7 0 0 1 0 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
	</svg>
}

templ AgentBadge() {
	<span class="badge agent" title="a goroutine of the gorviz agent; shown, but never counted in issues">
		@AgentIcon()
		agent
	</span>
}
