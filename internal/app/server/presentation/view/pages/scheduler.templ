package pages

import (
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/layout"
)

// SchedulerViewModel の StreamURL は最新を追っているときの SSE (なければ空)。Truncated は窓の変化が多すぎて途中で切ったこと
type SchedulerViewModel struct {
	Base      layout.BaseViewModel
	Picker    components.TimeRangePickerViewModel
	Past      bool
	LatestURL string
	Replay    components.GMPReplayViewModel
	StreamURL string
	Truncated bool
}

templ Scheduler(vm SchedulerViewModel) {
	@layout.Base(vm.Base) {
		<div class="overview-head">
			<h2>Scheduler</h2>
			if vm.Past {
				<span class="muted">a past moment</span>
				<a class="btn" href={ templ.SafeURL(vm.LatestURL) }>Latest</a>
			}
			@components.TimeRangePicker(vm.Picker)
		</div>
		@ReplayPanel(vm.Replay, vm.StreamURL, vm.Truncated)
	}
}

// ReplayPanel は GMP の再生。Scheduler と Goroutine で使う
templ ReplayPanel(replay components.GMPReplayViewModel, streamURL string, truncated bool) {
	if streamURL != "" {
		@turbo.StreamSSESource("gmp-stream", streamURL)
	}
	if truncated {
		@components.Notice() {
			<strong>replay</strong>
			<span>this range has too many state changes, so the replay stops early; pick a shorter range</span>
		}
	}
	@components.GMPReplay(replay)
	<p class="faint small replay-footnote">
		The run queue a RUNNABLE goroutine waited in is not recorded in the execution trace, so local and global run queues are inferred. How long it waited and which P and M ran it are as recorded. Goroutines of the gorviz agent are folded at the end of the parked list; when shown, they are dimmed and marked with an antenna.
	</p>
}
