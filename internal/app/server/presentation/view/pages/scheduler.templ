package pages

import (
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/layout"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/partials"
)

// SchedulerViewModel の Picker は再生する区間を選ぶ部品。LatestURL は今の長さで最新を開き直すリンク。
// Past が true なら Issue から時刻を指定して開いた区間を、false なら開いたときの最新の区間を再生する
type SchedulerViewModel struct {
	TargetURL  string
	Picker     components.TimeRangePickerViewModel
	Length     string
	LatestURL  string
	Past       bool
	// StreamURL は最新を見ているときの、新しい窓が届く SSE。過去の時刻を見ているときは空
	StreamURL  string
	ReplayJSON string
	Error      string
}

// Scheduler (見出しは Runtime Scheduler) は録画を選んだ長さだけ GMP の概念図で再生する。G を選ぶと Goroutine に移る
templ Scheduler(vm SchedulerViewModel) {
	@layout.Base(vm.TargetURL, "Scheduler") {
		if vm.StreamURL != "" {
			@turbo.StreamSSESource(partials.ReplayStreamSourceID, vm.StreamURL)
		}
		<div class="overview-head">
			<h2>Scheduler</h2>
			@schedulerTools(vm)
			@components.TimeRangePicker(vm.Picker)
		</div>
		if vm.Error != "" {
			<section class="panel error">{ vm.Error } <a class="btn" href={ templ.SafeURL(vm.LatestURL) }>Latest</a></section>
		} else {
			@components.GMPReplay(components.GMPReplayViewModel{DataID: partials.ReplayDataID, InitialJSON: vm.ReplayJSON, Length: vm.Length, Live: vm.StreamURL != "", RangeHost: partials.ReplayRangeID})
		}
	}
}

// schedulerTools は過去の時刻を見ているときの印
templ schedulerTools(vm SchedulerViewModel) {
	if vm.Past {
		<span class="muted">a past moment</span>
		<a class="btn" href={ templ.SafeURL(vm.LatestURL) }>Latest</a>
	}
}
