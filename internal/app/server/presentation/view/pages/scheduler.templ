package pages

import (
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/layout"
)

// SchedulerViewModel はスケジューラの動きの再生。StreamURL があれば、新しく届いた分を SSE で足していく
type SchedulerViewModel struct {
	Base      layout.BaseViewModel
	Range     string
	Live      bool
	LiveURL   string
	Replay    components.GMPReplayViewModel
	StreamURL string
	Truncated bool
}

templ Scheduler(vm SchedulerViewModel) {
	@layout.Base(vm.Base) {
		<div class="overview-head">
			<h2>Scheduler</h2>
			if vm.Live {
				<span class="muted">following the latest { vm.Range }</span>
			} else {
				<span class="muted mono">{ vm.Range }</span>
				<a class="btn small" href={ templ.SafeURL(vm.LiveURL) }>Follow the latest</a>
			}
		</div>
		@ReplayPanel(vm.Replay, vm.StreamURL, vm.Truncated)
	}
}

// ReplayPanel は GMP の再生。Scheduler と Goroutine で使う
templ ReplayPanel(replay components.GMPReplayViewModel, streamURL string, truncated bool) {
	if streamURL != "" {
		@turbo.StreamSSESource("gmp-stream", streamURL)
	}
	@components.GMPReplay(replay)
	<p class="faint small replay-footnote">
		The run queue a RUNNABLE goroutine waited in is not recorded in the execution trace, so local and global run queues are inferred. How long it waited and which P and M ran it are as recorded. Goroutines of the gorviz agent are dimmed.
		if truncated {
			This range has too many state changes, so the replay stops early. Open a shorter range.
		}
	</p>
}
