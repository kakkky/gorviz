package pages

import (
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/layout"
)

// IssuesViewModel は検出した問題の一覧
type IssuesViewModel struct {
	Base   layout.BaseViewModel
	Kind   string
	Text   string
	Kinds  []string
	Issues []IssueRowViewModel
}

type IssueRowViewModel struct {
	ID          string
	URL         string
	Kind        string
	Target      string
	Certainty   string
	Occurrences int
	FirstPhase  string
	First       string
	Last        string
	Value       string
}

templ Issues(vm IssuesViewModel) {
	@layout.Base(vm.Base) {
		<section class="panel">
			<form class="search-form" method="get" action="/issues">
				<select name="kind">
					<option value="">all kinds</option>
					for _, k := range vm.Kinds {
						<option value={ k } selected?={ k == vm.Kind }>{ k }</option>
					}
				</select>
				<input type="search" name="text" value={ vm.Text } placeholder="function"/>
				<button type="submit">Filter</button>
			</form>
		</section>
		<section class="panel">
			<h2>Issues <span class="muted">problems of the Go runtime found in this session</span></h2>
			if len(vm.Issues) == 0 {
				<p class="muted">No issue has been found yet.</p>
			} else {
				<table>
					<thead><tr><th>id</th><th>kind</th><th>target</th><th>certainty</th><th class="num">occurrences</th><th>first phase</th><th>first</th><th>last</th><th>latest</th></tr></thead>
					<tbody>
						for _, is := range vm.Issues {
							<tr>
								<td><a href={ templ.SafeURL(is.URL) }>{ is.ID }</a></td>
								<td>@components.Badge("kind", is.Kind)</td>
								<td class="mono origin">{ is.Target }</td>
								<td>@components.Badge(certainty(is.Certainty), is.Certainty)</td>
								<td class="num">{ is.Occurrences }</td>
								<td>{ is.FirstPhase }</td>
								<td class="mono">{ is.First }</td>
								<td class="mono">{ is.Last }</td>
								<td class="muted">{ is.Value }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</section>
	}
}

func certainty(c string) string {
	if c == "FACT" {
		return "fact"
	}
	return "inference"
}
