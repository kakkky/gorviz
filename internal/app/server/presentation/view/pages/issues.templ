package pages

import (
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/assets"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/layout"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/partials"
)

// IssuesViewModel は Issues の枠。一覧は StreamURL から SSE で届き、refresh ごとに新しくなる
type IssuesViewModel struct {
	TargetURL string
	StreamURL string
	Picker    components.TimeRangePickerViewModel
	// Search は種類と言葉で絞る検索のカード
	Search components.SearchFormViewModel
}

templ Issues(vm IssuesViewModel) {
	@layout.Base(vm.TargetURL, "Issues") {
		@turbo.StreamSSESource(partials.IssuesStreamSourceID, vm.StreamURL)
		<div class="overview-head">
			<h2>Issues</h2>
			<span class="hint" title="FACT: read directly from the runtime's judgement or the recorded trace / dump, or over a fixed threshold. INFERENCE: inferred by gorviz from trends or comparison with the usual rate.">FACT / INFERENCE?</span>
			@components.TimeRangePicker(vm.Picker)
		</div>
		@components.SearchForm(vm.Search)
		<div data-controller={ assets.ChartSyncController.Name } data-chart-sync-source-value={ partials.IssuesStreamSourceID }>
			<div id={ partials.IssueListID } class="stack">
				<section class="panel"><p class="muted">loading issues...</p></section>
			</div>
		</div>
	}
}
