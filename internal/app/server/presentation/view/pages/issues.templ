package pages

import (
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/layout"
)

type IssuesViewModel struct {
	TargetURL string
	At        string
	Issues    []IssueViewModel
	// Recordings は Issue をきっかけに server が保存した、前後の録画
	Recordings []RecordingViewModel
}

type RecordingViewModel struct {
	Kind      string
	Subject   string
	At        string
	Span      string
	Size      string
	Downloads []IssueLinkViewModel
}

// IssueViewModel はどの種類の Issue も同じ形で見せる
type IssueViewModel struct {
	Kind      string
	Certainty string
	Subject   string
	Summary   string
	Location  string
	Trend     components.SparklineViewModel
	Links     []IssueLinkViewModel
}

type IssueLinkViewModel struct {
	Label string
	URL   string
}

templ Issues(vm IssuesViewModel) {
	@layout.Base(vm.TargetURL, "Issues") {
		<section class="panel">
			<h2>Issues <span class="muted">detected at { vm.At } — <a href="/issues">refresh</a></span></h2>
			if len(vm.Issues) == 0 {
				<p class="muted">no issues detected</p>
			} else {
				<table class="issues">
					<tr><th>kind</th><th>certainty</th><th>subject</th><th>summary</th><th>trend</th><th>investigate</th></tr>
					for _, i := range vm.Issues {
						<tr>
							<td><span class="badge kind">{ i.Kind }</span></td>
							<td>@components.CertaintyBadge(i.Certainty)</td>
							<td class="origin">{ i.Subject }</td>
							<td>{ i.Summary }</td>
							<td>
								if i.Trend.Points != "" {
									<svg class="sparkline small" viewBox="0 0 100 100" preserveAspectRatio="none"><polyline points={ i.Trend.Points }></polyline></svg>
								}
							</td>
							<td class="links">
								for _, l := range i.Links {
									<a href={ templ.SafeURL(l.URL) }>{ l.Label }</a>
								}
							</td>
						</tr>
					}
				</table>
			}
			<p class="muted">FACT: read directly from the runtime's judgement or the recorded trace / dump, or over a fixed threshold. INFERENCE: inferred by gorviz from trends or comparison with the usual rate.</p>
		</section>
		<section class="panel">
			<h2>Saved recordings <span class="muted">the trace around each issue, kept after the agent's ring buffer drops it. Open a chunk with `go tool trace`</span></h2>
			if len(vm.Recordings) == 0 {
				<p class="muted">nothing saved yet</p>
			} else {
				<table class="issues">
					<tr><th>kind</th><th>subject</th><th>issue at</th><th>recorded</th><th>size</th><th>download</th></tr>
					for _, r := range vm.Recordings {
						<tr>
							<td><span class="badge kind">{ r.Kind }</span></td>
							<td class="origin">{ r.Subject }</td>
							<td>{ r.At }</td>
							<td>{ r.Span }</td>
							<td>{ r.Size }</td>
							<td class="links">
								for _, d := range r.Downloads {
									<a href={ templ.SafeURL(d.URL) } download>{ d.Label }</a>
								}
							</td>
						</tr>
					}
				</table>
			}
		</section>
	}
}
