package pages

import (
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/assets"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/layout"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/partials"
)

// IssueViewModel は Issue 1 つの枠。中身は StreamURL から SSE で届き、refresh ごとに新しくなる
type IssueViewModel struct {
	TargetURL string
	StreamURL string
	Picker    components.TimeRangePickerViewModel
}

templ Issue(vm IssueViewModel) {
	@layout.Base(vm.TargetURL, "Issues") {
		@turbo.StreamSSESource(partials.IssueStreamSourceID, vm.StreamURL)
		<div class="overview-head">
			<a class="btn" href="/issues">← Issues</a>
			<h2>Issue</h2>
			@components.TimeRangePicker(vm.Picker)
		</div>
		<div data-controller={ assets.ChartSyncController.Name } data-chart-sync-source-value={ partials.IssueStreamSourceID }>
			<div id={ partials.IssueDetailID } class="stack">
				<div class="panel skeleton">loading the issue...</div>
			</div>
		</div>
	}
}
