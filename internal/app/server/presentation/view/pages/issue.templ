package pages

import (
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/layout"
)

// IssueViewModel は 1 つの Issue。発生の時間軸と、選んだ発生で影響の大きかった goroutine
type IssueViewModel struct {
	Base         layout.BaseViewModel
	ID           string
	Kind         string
	Target       string
	Certainty    string
	FirstPhase   string
	NextAction   string
	Occurrences  []OccurrenceRowViewModel
	Showing      int
	Range        string
	SchedulerURL string
	Leaks        []LeakRowViewModel
	LockSites    []LockSiteRowViewModel
	Goroutines   []components.GoroutineCardViewModel
}

type OccurrenceRowViewModel struct {
	N         int
	URL       string
	Current   bool
	Range     string
	Phase     string
	Certainty string
	Value     string
}

type LeakRowViewModel struct {
	CreatedBy  string
	BlockedAt  string
	Reason     string
	Leaked     string
	Certainty  string
	Goroutines []LinkRowViewModel
}

type LinkRowViewModel struct {
	Label string
	URL   string
}

type LockSiteRowViewModel struct {
	Function string
	Location string
	Share    string
	Count    int
	Mean     string
	Max      string
	HeldBy   []LinkRowViewModel
}

templ Issue(vm IssueViewModel) {
	@layout.Base(vm.Base) {
		<section class="panel">
			<h2>
				{ vm.ID }
				@components.Badge("kind", vm.Kind)
				@components.Badge(certainty(vm.Certainty), vm.Certainty)
				<span class="mono">{ vm.Target }</span>
			</h2>
			if vm.FirstPhase != "" {
				<p class="muted">first seen in { vm.FirstPhase }</p>
			}
			<p class="hint">{ vm.NextAction }</p>
		</section>
		<section class="panel">
			<h2>Occurrences <span class="muted">each stretch of time the condition held</span></h2>
			<table>
				<thead><tr><th>#</th><th>range</th><th>phase</th><th>certainty</th><th>value</th></tr></thead>
				<tbody>
					for _, o := range vm.Occurrences {
						<tr class={ templ.KV("current", o.Current) }>
							<td><a href={ templ.SafeURL(o.URL) }>{ o.N }</a></td>
							<td class="mono">{ o.Range }</td>
							<td>{ o.Phase }</td>
							<td>@components.Badge(certainty(o.Certainty), o.Certainty)</td>
							<td class="muted">{ o.Value }</td>
						</tr>
					}
				</tbody>
			</table>
		</section>
		<section class="panel">
			<h2>Occurrence { vm.Showing } <span class="muted mono">{ vm.Range }</span></h2>
			<p><a class="btn" href={ templ.SafeURL(vm.SchedulerURL) }>Replay the scheduler →</a></p>
			if len(vm.Leaks) > 0 {
				<h3>Leaked goroutines, per place they wait at</h3>
				<table>
					<thead><tr><th>created by</th><th>blocked at</th><th>leaked</th><th>certainty</th><th>goroutines</th></tr></thead>
					<tbody>
						for _, l := range vm.Leaks {
							<tr>
								<td class="mono">{ l.CreatedBy }</td>
								<td class="mono">{ l.BlockedAt } <span class="faint">{ l.Reason }</span></td>
								<td>{ l.Leaked }</td>
								<td>@components.Badge(certainty(l.Certainty), l.Certainty)</td>
								<td>
									for _, g := range l.Goroutines {
										<a class="gchip is-static" href={ templ.SafeURL(g.URL) }>{ g.Label }</a>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if len(vm.LockSites) > 0 {
				<h3>Lock wait, per function that called Lock <span class="faint">many short waits mean the lock is taken too often; few long ones mean it is held for long</span></h3>
				<table>
					<thead><tr><th>called Lock</th><th class="num">share</th><th class="num">count</th><th class="num">mean</th><th class="num">max</th><th>held by</th></tr></thead>
					<tbody>
						for _, s := range vm.LockSites {
							<tr>
								<td class="mono">{ s.Function } <span class="faint">{ s.Location }</span></td>
								<td class="num">{ s.Share }</td>
								<td class="num">{ s.Count }</td>
								<td class="num">{ s.Mean }</td>
								<td class="num">{ s.Max }</td>
								<td>
									for _, h := range s.HeldBy {
										<a class="mono" href={ templ.SafeURL(h.URL) }>{ h.Label }</a>
										<br/>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			<h3>Goroutines affected the most</h3>
			if len(vm.Goroutines) == 0 {
				<p class="muted">No goroutine of the app was recorded in this range.</p>
			}
		</section>
		for _, g := range vm.Goroutines {
			@components.GoroutineCard(g)
		}
	}
}
