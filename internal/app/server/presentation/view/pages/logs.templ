package pages

import (
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/assets"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/layout"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/partials"
)

type LogsViewModel struct {
	TargetURL string
	// StreamURL は今に合わせて動く期間を見ているときの、一覧が届く SSE。決まった範囲を見ているときは空
	StreamURL string
	// Search はレベルと言葉で絞る検索のカード。期間は Picker で選び、検索し直しても保つ
	Search    components.SearchFormViewModel
	Logs      components.LogListViewModel
	Picker    components.TimeRangePickerViewModel
	TimeError string
}

templ Logs(vm LogsViewModel) {
	@layout.Base(vm.TargetURL, "Logs") {
		if vm.StreamURL != "" {
			@turbo.StreamSSESource(partials.LogsStreamSourceID, vm.StreamURL)
		}
		<div class="overview-head">
			<h2>Logs</h2>
			<span class="muted">click a line to see its fields · Goroutine → opens the moment it was written</span>
			@components.TimeRangePicker(vm.Picker)
		</div>
		<div class="logs-page">
			@components.SearchForm(vm.Search)
			if vm.TimeError != "" {
				<section class="panel error">{ vm.TimeError }</section>
			}
			// 件数の推移は Overview と同じく、hover で件数を出し、ドラッグで拡大する (chart-sync)
			<div data-controller={ assets.ChartSyncController.Name } data-chart-sync-source-value={ partials.LogsStreamSourceID }>
				<div id={ partials.LogListID } class="stack">
					@components.LogList(vm.Logs)
				</div>
			</div>
		</div>
	}
}
