package pages

import (
	"github.com/kakkky/hotwire-go/stimulus"

	"github.com/kakkky/gorviz/internal/app/server/assets"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/layout"
)

type LogsViewModel struct {
	Base      layout.BaseViewModel
	Picker    components.TimeRangePickerViewModel
	Search    components.SearchFormViewModel
	Chart     components.ChartViewModel
	Total     int
	Rows      []LogRowViewModel
	NextURL   string
	Retention *components.UnavailableViewModel
}

// LogRowViewModel は一覧の 1 行。Detail は開いた行 (URL の log) だけが持つ、書いた goroutine と残した trace
type LogRowViewModel struct {
	ID         string
	At         string
	Instance   string
	Level      string
	LevelClass string
	Message    string
	Duration   string
	Exact      bool
	OpenURL    string
	Fields     []KeyValueViewModel
	Raw        string
	Open       bool
	Detail     *LogDetailViewModel
}

type KeyValueViewModel struct {
	Key   string
	Value string
}

type LogDetailViewModel struct {
	At          string
	TimeNote    string
	Source      string
	Period      string
	PeriodNote  string
	Writer      LogWriterViewModel
	Preserved   []components.LinkItemViewModel
}

type LogWriterViewModel struct {
	Found         bool
	Goroutine     string
	Certainty     string
	CertaintyNote string
	URL           string
	SchedulerURL  string
	Note          string
	Unavailable   *components.UnavailableViewModel
}

templ Logs(vm LogsViewModel) {
	@layout.Base(vm.Base) {
		<div class="overview-head">
			<h2>Logs</h2>
			<span class="muted">click a line to see its fields · Goroutine → opens the goroutine that wrote it</span>
			@components.TimeRangePicker(vm.Picker)
		</div>
		<div class="logs-page">
			@components.SearchForm(vm.Search)
			if vm.Retention != nil {
				@components.Unavailable(*vm.Retention)
			}
			<section class="panel">
				@components.Chart(vm.Chart)
			</section>
			<section class="panel logs-list">
				<p class="muted log-count">{ len(vm.Rows) } of { vm.Total } lines, oldest first</p>
				<table class="log-table" { stimulus.AttrControllers(assets.RowDetailController.Name)... }>
					for _, l := range vm.Rows {
						<tr id={ l.ID } class={ "openable", templ.KV("is-open", l.Open) } { stimulus.AttrActions("click->" + assets.RowDetailController.Name + "#toggleRow")... }>
							<td class="log-toggle"><button type="button" class="row-toggle" aria-expanded={ boolText(l.Open) } title="show the line as it was logged" { stimulus.AttrActions("click->" + assets.RowDetailController.Name + "#toggle")... }></button></td>
							<td class="log-time">{ l.At }</td>
							<td><span class={ "level " + l.LevelClass }>{ l.Level }</span></td>
							<td class="log-message">{ l.Message }</td>
							<td class="side mono">{ l.Instance }</td>
							<td class="side num mono">{ l.Duration }</td>
							<td class="side log-open">
								<a class="btn small" href={ templ.SafeURL(l.OpenURL) } title="open the goroutine that wrote this line (the scheduler at that time when the goroutine is unknown)">
									Goroutine
									if !l.Exact {
										<span class="badge inference" title="the line has no number from the logger adapter, so the goroutine is inferred from the time (only when one goroutine was running)">?</span>
									}
									→
								</a>
							</td>
						</tr>
						<tr class="log-detail" hidden?={ !l.Open } data-open?={ l.Open }>
							<td></td>
							<td colspan="6">
								if l.Detail != nil {
									@logDetail(*l.Detail)
								}
								if len(l.Fields) > 0 {
									<table class="log-fields">
										for _, f := range l.Fields {
											<tr><th>{ f.Key }</th><td>{ f.Value }</td></tr>
										}
									</table>
								} else {
									<pre>{ l.Raw }</pre>
								}
							</td>
						</tr>
					}
				</table>
				if vm.NextURL != "" {
					<p><a class="btn" href={ templ.SafeURL(vm.NextURL) }>newer lines</a></p>
				}
			</section>
		</div>
	}
}

templ logDetail(d LogDetailViewModel) {
	<table class="kv log-detail-kv">
		<tr><th>written at</th><td class="mono">{ d.At } <span class="faint">{ d.TimeNote }</span></td></tr>
		<tr><th>read from</th><td>{ d.Source }</td></tr>
		<tr>
			<th>written by</th>
			<td>
				if d.Writer.Found {
					<a class="gchip" href={ templ.SafeURL(d.Writer.URL) } title="open the goroutine over the period below"><span class="gdot cause-bg-RUNNING"></span>{ d.Writer.Goroutine }</a>
					@components.CertaintyBadge(d.Writer.Certainty, d.Writer.CertaintyNote)
				} else if d.Writer.Unavailable != nil {
					<span class="muted">{ d.Writer.Unavailable.Text }</span>
				} else {
					<span class="muted">{ d.Writer.Note }</span>
					<a class="btn small" href={ templ.SafeURL(d.Writer.SchedulerURL) }>Scheduler at that time →</a>
				}
			</td>
		</tr>
		<tr><th>period to look at</th><td><span class="mono">{ d.Period }</span> <span class="faint">{ d.PeriodNote }</span></td></tr>
		if len(d.Preserved) > 0 {
			<tr>
				<th title="execution traces kept around error logs like this one; they stay after the full trace is gone">kept traces</th>
				<td>@components.LinkList(d.Preserved)</td>
			</tr>
		}
	</table>
}
