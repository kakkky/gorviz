package pages

import (
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/layout"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/partials"
)

type GoroutineViewModel struct {
	TargetURL string
	Error     string
	Goroutine string
	// GoroutineID は番号だけ (再生に渡す)
	GoroutineID string
	Entry     string
	Interval  components.TimeRangeViewModel
	At        string
	Leaked    bool
	// 診断
	Primary    string
	Certainty  string
	Function   string
	Location   string
	WaitReason string
	CreatedBy  string
	// Wake は主因の状態を一番長く続けた 1 回 (再生の帯で枠を付ける区間) の待ちを、誰が起こしたか (待ちでなければ nil)
	Wake *GoroutineWakeViewModel
	// 根拠
	ReplayJSON string
	NoReplay   string
	// StreamURL は最新を追っているときの、新しい窓が届く SSE。LatestURL はこの G を最新で開き直す
	StreamURL string
	LatestURL string
	Length     string
	Picker     components.TimeRangePickerViewModel
	// Issues はこの G (リークなら同じ生成元) を含む Issue
	Issues []components.LinkViewModel
}

// GoroutineWakeViewModel の Kind は "goroutine" (別の G が起こした)・"runtime" (タイマー・ネットワークのポーラー)・"waiting" (区間の終わりまで待っていた)。
// Busy* は待っていた間に、起こした G が何をしていたか (主因・その長さ・場所)
type GoroutineWakeViewModel struct {
	Kind         string
	Goroutine    string
	URL          string
	Entry        string
	Function     string
	Location     string
	BusyCause    string
	BusyFor      string
	BusyShare    string
	BusyFunction string
	BusyLocation string
}

templ Goroutine(vm GoroutineViewModel) {
	@layout.Base(vm.TargetURL, "") {
		if vm.Error != "" {
			<section class="panel error">{ vm.Error }</section>
		} else {
			if vm.StreamURL != "" {
				@turbo.StreamSSESource(partials.ReplayStreamSourceID, vm.StreamURL)
			}
			<div class="overview-head">
				<h2>Goroutine</h2>
				if vm.StreamURL == "" {
					<span class="muted">a past moment</span>
					<a class="btn" href={ templ.SafeURL(vm.LatestURL) }>Latest</a>
				}
				if vm.ReplayJSON != "" {
					@components.TimeRangePicker(vm.Picker)
				}
			</div>
			// 再生で別の G を選ぶと、この枠だけをその G の画面に差し替える (gmp-replay の selectOnPage)
			<turbo-frame id="goroutine-diagnosis" target="_top">
				<section class="panel goroutine-card" data-goroutine-card>
					<div class="goroutine-card-head">
						// 閉じた (再生で G を選んでいない) ときは、この G の見出しの代わりにこれだけを出す
						<span class="goroutine-none">Goroutine <span class="muted">none selected · pick one in the replay</span></span>
						<span class="following-label" title="this goroutine is followed in the replay below">following</span>
						<strong class="mono">{ vm.Goroutine }</strong>
						<span class="goroutine-entry">{ vm.Entry }</span>
						if vm.Leaked {
							<span class="badge kind">LEAK</span>
							@components.CertaintyBadge("FACT")
						}
						<div class="actions">
							for _, i := range vm.Issues {
								<a class="btn" href={ templ.SafeURL(i.URL) } title="the issue that includes this goroutine">{ i.Label }</a>
							}
							<button type="button" class="card-close" data-goroutine-close title="stop following this goroutine" aria-label="close">×</button>
						</div>
					</div>
					<div class="goroutine-card-body">
						<div class="goroutine-card-col">
							<h3>Diagnosis <span class="faint">over the interval below</span></h3>
							if vm.Primary == "" {
								<p class="muted">no record of this goroutine in the interval (not in the recorded trace nor in the latest goroutine dump)</p>
							} else {
								<p>
									<span class={ "badge", "cause", "cause-" + vm.Primary }>{ vm.Primary }</span>
									@components.CertaintyBadge(vm.Certainty)
								</p>
							}
							<table class="kv">
								<tr><th>interval</th><td>@components.TimeRange(vm.Interval)</td></tr>
								<tr><th>at</th><td class="mono">{ vm.At }</td></tr>
								<tr><th>stopped in</th><td class="origin">{ vm.Function }</td></tr>
								<tr><th>location</th><td class="origin" title={ vm.Location }>{ components.ShortPath(vm.Location) }</td></tr>
								<tr><th>wait reason</th><td>{ vm.WaitReason }</td></tr>
								if vm.Wake != nil {
									<tr><th title="who made this goroutine runnable at the end of the longest wait">woken by</th><td>@goroutineWake(*vm.Wake)</td></tr>
								}
								<tr><th>created by</th><td class="origin" title={ vm.CreatedBy }>{ components.ShortPath(vm.CreatedBy) }</td></tr>
							</table>
						</div>
						// 再生の中で追っている G の状態の推移と内訳を、診断の隣に描く (gmp-replay の focusHost)
						<div class="goroutine-card-col">
							<h3>In the replay <span class="faint">at the replay's current position</span></h3>
							<div id="goroutine-focus" class="goroutine-focus"></div>
						</div>
					</div>
				</section>
			</turbo-frame>
			if vm.ReplayJSON != "" {
				@components.GMPReplay(components.GMPReplayViewModel{DataID: partials.ReplayDataID, InitialJSON: vm.ReplayJSON, PageGoroutine: vm.GoroutineID, Length: vm.Length, FocusHost: "goroutine-focus", Live: vm.StreamURL != "", RangeHost: partials.ReplayRangeID})
			} else {
				<section class="panel muted">{ vm.NoReplay }</section>
			}
		}
	}
}

// goroutineWake は一番長い待ちを解いたのが誰かを、「誰が・どうやって・その間何をしていたか」の順に並べる
templ goroutineWake(w GoroutineWakeViewModel) {
	switch w.Kind {
		case "goroutine":
			<dl class="wake">
				<dt>who</dt>
				<dd>
					// 再生の G と同じ chip で、色は待っていた間のその G の主因
					<a class="gchip" href={ templ.SafeURL(w.URL) } title="open this goroutine over the wait"><span class={ "gdot", wakeDotClass(w.BusyCause) }></span>{ w.Goroutine }</a>
					<span class="origin" title={ w.Entry }>{ components.ShortPath(w.Entry) }</span>
				</dd>
				if w.Function != "" {
					<dt title="what the waking goroutine called to make this one runnable (an unlock, a channel send, ...)">how</dt>
					<dd><span class="origin" title={ w.Function }>{ components.ShortPath(w.Function) }</span> <span class="origin faint" title={ w.Location }>{ components.ShortPath(w.Location) }</span></dd>
				}
				if w.BusyCause != "" {
					<dt title="what the waking goroutine was doing while this one waited">meanwhile</dt>
					<dd>
						<span class="wake-cause"><span class={ "cause-dot", "cause-bg-" + w.BusyCause }></span><span class="cause-name">{ w.BusyCause }</span></span>
						<span class="mono">{ w.BusyFor }</span> <span class="faint">({ w.BusyShare } of the wait)</span>
						if w.BusyLocation != "" {
							<span class="origin faint" title={ w.BusyFunction + " " + w.BusyLocation }>{ components.ShortPath(w.BusyLocation) }</span>
						}
					</dd>
				}
			</dl>
		case "runtime":
			<dl class="wake">
				<dt>who</dt>
				<dd><span class="gchip is-static" title="a timer or the network poller"><span class="gdot other"></span>runtime</span></dd>
			</dl>
		default:
			<span title="still waiting at the end of the interval">-</span>
	}
}

func wakeDotClass(cause string) string {
	if cause == "" {
		return "other"
	}
	return "cause-bg-" + cause
}
