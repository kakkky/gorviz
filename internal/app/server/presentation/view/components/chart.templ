package components

import (
	"strconv"

	"github.com/kakkky/hotwire-go/stimulus"

	"github.com/kakkky/gorviz/internal/app/server/assets"
)

// ChartViewModel は server が座標まで決めた時系列のグラフ。プロットは viewBox (1000 × 160) の SVG、目盛りは HTML で置く (文字を伸ばさないため)。
// Title・Note は画面がパネルの見出しに出す。Hovers は区切りごとの透明な帯で、title に値を出し、URL があればそこへ移る。
// Zoom があれば、ドラッグで選んだ範囲を画面の期間にして開き直す
type ChartViewModel struct {
	Title          string
	Note           string
	Legend         []ChartLegendViewModel
	Lines          []ChartLineViewModel
	Bars           []ChartBarViewModel
	YTicks         []ChartTickViewModel
	XTicks         []ChartTickViewModel
	GridY          []string
	GridX          []string
	Marks          []ChartMarkViewModel
	Hovers         []ChartHoverViewModel
	ThresholdY     string
	ThresholdLabel string
	Empty          string
	Zoom           *ChartZoomViewModel
}

// ChartZoomViewModel の From・To はグラフの横軸の端、First は最初の区切りの始まり、Step は区切りの長さ (どれも Unix ミリ秒)。
// 区切りは軸の端に揃っていないことがあるので、選んだ範囲は First から Steps 個の区切りに揃える
type ChartZoomViewModel struct {
	From  int64
	To    int64
	First int64
	Step  int64
	Steps int
}

type ChartLegendViewModel struct {
	Label string
	Class string
	Value string
}

type ChartLineViewModel struct {
	Class  string
	Path   string
	Dashed bool
}

type ChartBarViewModel struct {
	Class string
	X     string
	Y     string
	W     string
	H     string
}

// ChartTickViewModel の Pos は、目盛りの位置 (Y は下から、X は左からの割合)
type ChartTickViewModel struct {
	Pos   string
	Label string
}

type ChartMarkViewModel struct {
	X     string
	Class string
	Title string
}

type ChartHoverViewModel struct {
	X     string
	W     string
	Title string
	URL   string
}

templ Chart(vm ChartViewModel) {
	<div class="chart" { chartZoomAttrs(vm.Zoom)... }>
		if len(vm.Legend) > 0 || vm.ThresholdLabel != "" {
			<div class="legend">
				for _, l := range vm.Legend {
					<span><i class={ l.Class }></i>{ l.Label }
						if l.Value != "" {
							<span class="mono legend-value">{ l.Value }</span>
						}
					</span>
				}
				if vm.ThresholdLabel != "" {
					<span><i class="threshold"></i>{ vm.ThresholdLabel }</span>
				}
			</div>
		}
		<div class="chart-body">
			<div class="chart-y mono">
				for _, t := range vm.YTicks {
					<span style={ templ.SafeCSS("bottom:" + t.Pos) }>{ t.Label }</span>
				}
			</div>
			<div class="chart-plot" { chartZoomPlotAttrs(vm.Zoom)... }>
				<svg viewBox="0 0 1000 160" preserveAspectRatio="none">
					for _, y := range vm.GridY {
						<line class="chart-grid" x1="0" y1={ y } x2="1000" y2={ y }></line>
					}
					for _, x := range vm.GridX {
						<line class="chart-grid" x1={ x } y1="0" x2={ x } y2="160"></line>
					}
					<line class="chart-baseline" x1="0" y1="160" x2="1000" y2="160"></line>
					if vm.ThresholdY != "" {
						<line class="chart-threshold" x1="0" y1={ vm.ThresholdY } x2="1000" y2={ vm.ThresholdY }><title>{ vm.ThresholdLabel }</title></line>
					}
					for _, b := range vm.Bars {
						<rect class={ "bar", b.Class } x={ b.X } y={ b.Y } width={ b.W } height={ b.H }></rect>
					}
					for _, l := range vm.Lines {
						<path class={ "line", l.Class, templ.KV("dashed", l.Dashed) } d={ l.Path }></path>
					}
					for _, m := range vm.Marks {
						<line class={ "chart-mark", m.Class } x1={ m.X } x2={ m.X } y1="0" y2="160"><title>{ m.Title }</title></line>
					}
					for _, h := range vm.Hovers {
						if h.URL != "" {
							<a href={ templ.SafeURL(h.URL) }><rect class="chart-hover" x={ h.X } y="0" width={ h.W } height="160"><title>{ h.Title }</title></rect></a>
						} else {
							<rect class="chart-hover" x={ h.X } y="0" width={ h.W } height="160"><title>{ h.Title }</title></rect>
						}
					}
				</svg>
				if vm.Empty != "" {
					<div class="chart-empty muted">{ vm.Empty }</div>
				}
			</div>
		</div>
		<div class="chart-x mono">
			for _, x := range vm.XTicks {
				<span style={ templ.SafeCSS("left:" + x.Pos) }>{ x.Label }</span>
			}
		</div>
	</div>
}

func chartZoomAttrs(z *ChartZoomViewModel) stimulus.Attrs {
	if z == nil {
		return nil
	}
	name := assets.ChartZoomController.Name
	attrs := stimulus.AttrControllers(name)
	attrs = append(attrs, stimulus.AttrValue(name, "from", strconv.FormatInt(z.From, 10))...)
	attrs = append(attrs, stimulus.AttrValue(name, "to", strconv.FormatInt(z.To, 10))...)
	attrs = append(attrs, stimulus.AttrValue(name, "first", strconv.FormatInt(z.First, 10))...)
	attrs = append(attrs, stimulus.AttrValue(name, "step", strconv.FormatInt(z.Step, 10))...)
	return append(attrs, stimulus.AttrValue(name, "steps", strconv.Itoa(z.Steps))...)
}

func chartZoomPlotAttrs(z *ChartZoomViewModel) stimulus.Attrs {
	if z == nil {
		return nil
	}
	name := assets.ChartZoomController.Name
	attrs := stimulus.AttrTargets(name, "plot")
	return append(attrs, stimulus.AttrActions("pointerdown->"+name+"#down", "pointermove->"+name+"#move")...)
}
