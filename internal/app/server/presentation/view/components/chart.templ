package components

// ChartViewModel は時間幅ごとの値の推移 1 つ。Path は SVG の polyline の点で、横は 0〜1000、縦は 0〜100 に収めてある
type ChartViewModel struct {
	Title  string
	Unit   string
	Max    string
	Last   string
	Points string
	Marks  []ChartMarkViewModel
}

type ChartMarkViewModel struct {
	X     string
	Title string
}

templ Chart(vm ChartViewModel) {
	<figure class="panel chart">
		<figcaption>
			<strong>{ vm.Title }</strong>
			<span class="muted">now { vm.Last } · max { vm.Max } { vm.Unit }</span>
		</figcaption>
		<svg viewBox="0 0 1000 100" preserveAspectRatio="none" class="chart-svg" role="img" aria-label={ vm.Title }>
			for _, m := range vm.Marks {
				<line x1={ m.X } x2={ m.X } y1="0" y2="100" class="chart-mark"><title>{ m.Title }</title></line>
			}
			<polyline points={ vm.Points } class="chart-line" vector-effect="non-scaling-stroke"></polyline>
		</svg>
	</figure>
}
