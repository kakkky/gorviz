package components

import "strconv"

// IssueDetailViewModel は Issue 1 つの推移と、期間の中で見つかった回。Kept が false なら保持期間を過ぎたか、まだ見つかっていない
type IssueDetailViewModel struct {
	Kept      bool
	Kind      string
	Certainty string
	Subject   string
	Location  string
	// Summary と LastSeen はいちばん新しく見つかった回 (期間によらない)
	Summary   string
	Active    bool
	FirstSeen string
	LastSeen  string
	Count     int
	Range     TimeRangeViewModel
	// Steps は推移のグラフの横軸 (JSON)。hover と拡大で JS が読む
	Steps       string
	ResetURL    string
	Chart       ChartViewModel
	Occurrences []IssueOccurrenceRowViewModel
	// MoreOccurrences は一覧に出しきれなかった回の数
	MoreOccurrences int
}

type IssueOccurrenceRowViewModel struct {
	Time       string
	Age        string
	Summary    string
	Replayable bool
	Links      []LinkViewModel
}

templ IssueDetail(vm IssueDetailViewModel) {
	if !vm.Kept {
		<section class="panel muted">this issue is not kept (older than the retention, or not seen yet)</section>
	} else {
		<section class="panel">
			<h2>
				<span class="badge kind">{ vm.Kind }</span>
				@CertaintyBadge(vm.Certainty)
				<span class="origin issue-subject" title={ vm.Subject }>{ ShortPath(vm.Subject) }</span>
				if vm.Active {
					<span class="active-dot" title="seen in the last 2 minutes"></span>
				}
			</h2>
			<p>{ vm.Summary }</p>
			<div class="meta">
				<span>first seen<span class="value">{ vm.FirstSeen }</span></span>
				<span>last seen<span class="value">{ vm.LastSeen }</span></span>
				<span>seen in range<span class="value">{ strconv.Itoa(vm.Count) }</span></span>
				if vm.Location != "" && vm.Location != vm.Subject {
					<span title={ vm.Location }>location<span class="value">{ ShortPath(vm.Location) }</span></span>
				}
			</div>
		</section>
		<section class="panel">
			<div class="range-info" data-chart-steps={ vm.Steps }>
				if vm.ResetURL != "" {
					@ResetZoomButton(vm.ResetURL)
				}
			</div>
			@chart(vm.Chart, "not seen in this range")
		</section>
		<section class="panel">
			<h2>Occurrences <span class="muted">newest first · the issue is recorded at most once a minute while it lasts</span></h2>
			if len(vm.Occurrences) == 0 {
				<p class="muted">not seen in this range</p>
			} else {
				<table class="issues">
					<tr><th>seen at</th><th></th><th>summary</th><th></th></tr>
					for _, o := range vm.Occurrences {
						<tr>
							<td class="mono">{ o.Time }</td>
							<td class="muted">{ o.Age }</td>
							<td class="muted">{ o.Summary }</td>
							<td class="links">
								if o.Replayable {
									for _, l := range o.Links {
										<a class="btn small" href={ templ.SafeURL(l.URL) }>{ l.Label }</a>
									}
								} else {
									<span class="faint" title="the trace at this time is no longer kept">not recorded</span>
								}
							</td>
						</tr>
					}
				</table>
				if vm.MoreOccurrences > 0 {
					<p class="muted">and { strconv.Itoa(vm.MoreOccurrences) } older occurrences in this range</p>
				}
			}
		</section>
	}
}
