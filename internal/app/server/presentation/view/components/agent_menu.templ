package components

import (
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/assets"
)

// AgentMenuFrameID は見出しの、見ている対象 (service とインスタンス) を切り替える部品の turbo-frame。
// 画面は agent ごとに分かれていて agent の一覧を知らないので、一覧を持つ入口 (AgentRouter) から読み込む
const AgentMenuFrameID = "agent-menu"

// AgentMenuViewModel の Current は今見ているインスタンス。Groups は service ごとのインスタンス
type AgentMenuViewModel struct {
	Current AgentMenuItemViewModel
	Groups  []AgentMenuGroupViewModel
	// Empty は agent が 1 つもつながっていないとき
	Empty bool
}

type AgentMenuGroupViewModel struct {
	Service string
	Agents  []AgentMenuItemViewModel
}

type AgentMenuItemViewModel struct {
	Service   string
	Name      string
	Target    string
	Connected bool
	Current   bool
	SelectURL string
}

// AgentMenuFrame は見出しに置く枠。中身は src から読み込み、読み込むまでは fallback (今の対象の文字) を出す
templ AgentMenuFrame(fallback string) {
	@turbo.Frame(AgentMenuFrameID, turbo.AttrSrc("/agents/menu")) {
		<span class="target">{ fallback }</span>
	}
}

templ AgentMenu(vm AgentMenuViewModel) {
	@turbo.Frame(AgentMenuFrameID) {
		if vm.Empty {
			<a class="agent-switch empty" href="/agents" data-turbo-frame="_top">no agent connected</a>
		} else {
			<details class="trp agent-menu" data-controller={ assets.TimeRangePickerController.Name }>
				<summary class="agent-switch" title="switch the service and instance to look at">
					<span class={ "agent-dot", templ.KV("connected", vm.Current.Connected) }></span>
					if vm.Current.Service != "" {
						<strong>{ vm.Current.Service }</strong>
						<span class="sep">·</span>
					}
					<span class="mono">{ vm.Current.Name }</span>
					<span class="trp-caret" aria-hidden="true"></span>
				</summary>
				<div class="trp-pop agent-pop">
					for _, g := range vm.Groups {
						<div class="agent-group">
							<div class="agent-group-head">{ g.Service }</div>
							for _, a := range g.Agents {
								<a class={ "agent-item", templ.KV("current", a.Current) } href={ templ.SafeURL(a.SelectURL) } data-turbo-frame="_top">
									<span class={ "agent-dot", templ.KV("connected", a.Connected) }></span>
									<span class="mono">{ a.Name }</span>
									<span class="faint">{ a.Target }</span>
									if !a.Connected {
										<span class="faint">disconnected</span>
									}
								</a>
							}
						</div>
					}
				</div>
			</details>
		}
	}
}
