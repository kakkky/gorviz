package components

import "strconv"

type LogListViewModel struct {
	Total     int
	Shown     int
	Histogram []LogHistogramBarViewModel
	Lines     []LogRowViewModel
	// ShowSource は取り込み元が複数あるときだけ、行ごとに取り込み元を出す
	ShowSource bool
}

type LogHistogramBarViewModel struct {
	Title    string
	Segments []LogHistogramSegmentViewModel
}

type LogHistogramSegmentViewModel struct {
	Class  string
	Height string
}

type LogRowViewModel struct {
	Time       string
	Level      string
	LevelClass string
	Message    string
	Source     string
	Replayable bool
	ReplayURL  string
	// Exact はログを書いた G まで trace で特定できる (gorviz のロガーの差し込み口経由の) 行か
	Exact    bool
	Duration string
	// OverviewURL はこの行の前後の時間帯の Overview
	OverviewURL string
}

templ LogList(vm LogListViewModel) {
	<div class="histogram">
		for _, bar := range vm.Histogram {
			<div class="histogram-bar" title={ bar.Title }>
				for _, seg := range bar.Segments {
					<div class={ seg.Class } style={ templ.SafeCSS("height:" + seg.Height) }></div>
				}
			</div>
		}
	</div>
	<p class="muted log-count">{ strconv.Itoa(vm.Shown) } of { strconv.Itoa(vm.Total) } lines, newest first</p>
	<table class="log-table">
		for _, l := range vm.Lines {
			<tr class={ templ.KV("replayable", l.Replayable) }>
				<td class="log-time">{ l.Time }</td>
				<td><span class={ "level " + l.LevelClass }>{ l.Level }</span></td>
				<td class="log-message">
					if l.Replayable {
						<a href={ templ.SafeURL(l.ReplayURL) } data-turbo-frame={ LogReplayFrameID }>{ l.Message }</a>
					} else {
						<span title="the trace around this line is not recorded">{ l.Message }</span>
					}
				</td>
				<td class="side">
					if l.Replayable && !l.Exact {
						<span title="the goroutine that wrote this line is inferred from the timestamp (plug gorviz into your logger to identify it exactly)">G?</span>
					}
				</td>
				<td class="side">{ l.Duration }</td>
				<td class="side"><a href={ templ.SafeURL(l.OverviewURL) } data-turbo-frame="_top" title="open the overview around this time (±5m)">overview</a></td>
				if vm.ShowSource {
					<td class="side">{ l.Source }</td>
				}
			</tr>
		}
	</table>
}

const LogReplayFrameID = "log-replay"
