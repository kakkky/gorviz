package components

import (
	"strconv"

	"github.com/kakkky/hotwire-go/stimulus"

	"github.com/kakkky/gorviz/internal/app/server/assets"
)

type LogListViewModel struct {
	Total     int
	Shown     int
	// Steps・Chart は件数の推移 (レベルごとに積み上げた棒)。Overview・Issues と同じ横軸・hover・拡大。ResetURL は拡大を外す先
	Steps    string
	Chart    ChartViewModel
	ResetURL string
	Lines     []LogRowViewModel
	// ShowSource は取り込み元が複数あるときだけ、行ごとに取り込み元を出す
	ShowSource bool
}

type LogFieldViewModel struct {
	Key   string
	Value string
}

type LogRowViewModel struct {
	// ID は行の要素の id。SSE で一覧が書き換わっても、開いた行を同じ行と分かるようにする
	ID         string
	Time       string
	Level      string
	LevelClass string
	Message    string
	Source     string
	// Exact はログを書いた G まで trace で特定できる (gorviz のロガーの差し込み口経由の) 行か
	Exact    bool
	// Fields は行を開いたときに見せる、JSON の行のキーと値。JSON でなければ Detail に取り込んだままの行。どちらも空なら開くものがない
	Fields []LogFieldViewModel
	Detail string
	// OpenURL はこの行を書いた瞬間を開く先 (書いた G が分かれば Goroutine、分からなければ Scheduler)。録画がなければ空
	OpenURL string
}

// LogList は件数の推移のカードと、行の一覧のカードを並べる。行を押すと取り込んだままの行 (JSON ならキーと値) を開け閉めし、
// 右端のボタンで、その行を書いた goroutine (分からなければ Scheduler) の、書いた瞬間を開く
templ LogList(vm LogListViewModel) {
	<section class="panel">
		<div class="range-info" data-chart-steps={ vm.Steps }>
			if vm.ResetURL != "" {
				@ResetZoomButton(vm.ResetURL)
			}
		</div>
		@chart(vm.Chart, "no log line in this range")
	</section>
	<section class="panel logs-list">
		<p class="muted log-count">{ strconv.Itoa(vm.Shown) } of { strconv.Itoa(vm.Total) } lines, newest first</p>
		<table class="log-table" { stimulus.AttrControllers(assets.RowDetailController.Name)... }>
			for _, l := range vm.Lines {
				<tr id={ l.ID } class={ templ.KV("openable", hasDetail(l)) } if hasDetail(l) { data-action={ "click->" + assets.RowDetailController.Name + "#toggleRow" } }>
					@logRowCells(vm, l)
				</tr>
				if hasDetail(l) {
					<tr id={ l.ID + "-detail" } class="log-detail" hidden>
						<td></td>
						<td colspan="4">
							if len(l.Fields) > 0 {
								<table class="log-fields">
									for _, f := range l.Fields {
										<tr><th>{ f.Key }</th><td>{ f.Value }</td></tr>
									}
								</table>
							} else {
								<pre>{ l.Detail }</pre>
							}
						</td>
					</tr>
				}
			}
		</table>
	</section>
}

templ logRowCells(vm LogListViewModel, l LogRowViewModel) {
	<td class="log-toggle">
		if hasDetail(l) {
			<button type="button" class="row-toggle" aria-expanded="false" title="show the line as it was logged" data-action={ "click->" + assets.RowDetailController.Name + "#toggle" }></button>
		}
	</td>
	<td class="log-time">{ l.Time }</td>
	<td><span class={ "level " + l.LevelClass }>{ l.Level }</span></td>
	<td class="log-message">{ l.Message }</td>
	<td class="side log-open">
		if l.OpenURL != "" {
			<a class="btn small" href={ templ.SafeURL(l.OpenURL) } title="open the goroutine that wrote this line, at the moment it was written (the scheduler when the goroutine is unknown)">
				Goroutine
				if !l.Exact {
					<span class="badge inference" title="the goroutine that wrote this line is inferred from the timestamp (plug gorviz into your logger to identify it exactly)">?</span>
				}
				→
			</a>
		} else {
			<span class="faint" title="the trace around this line is not recorded">not recorded</span>
		}
	</td>
	if vm.ShowSource {
		<td class="side">{ l.Source }</td>
	}
}

func hasDetail(l LogRowViewModel) bool {
	return len(l.Fields) > 0 || l.Detail != ""
}
