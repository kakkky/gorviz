package components

import "strconv"

// OverviewViewModel は選んだ期間 (Range) の推移と、今の様子。推移のグラフはすべて同じ横軸 (期間と区切り Step) で描く
type OverviewViewModel struct {
	At    string
	Range string
	Step  string
	// Steps は全グラフで共通の横軸 (JSON)。hover と拡大で JS が読む
	Steps string
	// ResetURL は拡大しているときの、元の期間に戻るリンク。拡大していなければ空
	ResetURL string
	// LogsURL は表示している時間帯のログ
	LogsURL string
	// DataSince は期間の途中から集計を始めていたときの、最初の集計の時刻。それより前は no data
	DataSince string
	// Replayable は録画が残っていて、GMP 再生や診断ができる区間
	Replayable string

	IssueCount int
	Issues     []OverviewIssueViewModel

	HasSnapshot   bool
	GoroutinesNow int
	// Procs は P の数 (GOMAXPROCS)。Waiting for P の大きさはこれと比べて見る
	Procs int
	States        []GoroutineStateViewModel
	DumpAt        string
	LeakCheck     string
	Origins       []OriginRowViewModel

	Goroutines  ChartViewModel
	CPUWaiting  ChartViewModel
	GC          ChartViewModel
	Heap        ChartViewModel
	MarkAssist  ChartViewModel
	// EffectiveGOGC は期間の中で最後に終わった GC の goal / live heap から逆算した GOGC。GC がなければ空
	EffectiveGOGC string
}

type OverviewIssueViewModel struct {
	Kind      string
	Certainty string
	Subject   string
	Summary   string
	Age       string
	Href      string
}

type GoroutineStateViewModel struct {
	Label string
	Count int
	Class string
}

// OriginRowViewModel の Now は最新の dump での数 (多い順の上位にいなければ HasNow が false)、Max は表示している期間中の最大
type OriginRowViewModel struct {
	Origin string
	Now    int
	HasNow bool
	Max    int
	HasMax bool
}

// ChartViewModel は viewBox 0 0 1000 160 で描くグラフ。文字は SVG の外 (HTML) に置き、引き伸ばしで歪まないようにする。
// Readout は hover で出す値 (JSON)。縦線と値は JS (chart_sync_controller) が、すべてのグラフの同じ時刻に描く
type ChartViewModel struct {
	YTicks  []ChartTickViewModel
	XLabels []ChartTickViewModel
	// GridX と GridY は補助線の位置 (viewBox の座標)
	GridX   []string
	GridY   []string
	Lines   []ChartPathViewModel
	Bars    []ChartRectViewModel
	Legend  []ChartLegendViewModel
	Readout string
	// Kind は "line" か "bar"。hover で、カーソルが線の近くか棒の上にあるかの見方を変える
	Kind string
	// Notes は hover の値の下に添える、区切りごとの補足 (JSON、[[{label, text}]])。なければ空
	Notes string
	// NoData は左端から集計がない部分の幅 (%)
	NoData string
	Empty  bool
	// ThresholdY は Issue の閾値の縦の位置 (viewBox の座標)。空なら線を引かない
	ThresholdY     string
	ThresholdLabel string
}

// ChartTickViewModel の Pos は、縦軸なら下端から、横軸なら左端からの位置 (%)
type ChartTickViewModel struct {
	Pos  string
	Text string
}

type ChartPathViewModel struct {
	Class string
	D     string
}

type ChartRectViewModel struct {
	Class string
	X     string
	Y     string
	W     string
	H     string
}

type ChartLegendViewModel struct {
	Label string
	Class string
}

// OverviewSnapshot は全体の様子を 1 画面で見せる。上に今の様子 (Status)、下に期間の推移を Goroutines・Memory & GC・CPU の段に分けて並べ、
// 問題に気づいたら Issues・Logs・Goroutine へ進む
templ OverviewSnapshot(vm OverviewViewModel) {
	<div class="range-info" data-chart-steps={ vm.Steps }>
		<span>showing <span class="mono">{ vm.Range }</span></span>
		if vm.ResetURL != "" {
			<a href={ templ.SafeURL(vm.ResetURL) } data-chart-reset>reset zoom</a>
		}
		<a href={ templ.SafeURL(vm.LogsURL) }>logs in this range →</a>
		<span class="faint">{ vm.Step } per point · updated <span class="mono">{ vm.At }</span></span>
		if vm.DataSince != "" {
			<span class="faint">no data before <span class="mono">{ vm.DataSince }</span></span>
		}
		if vm.Replayable != "" {
			<span class="faint" title="gorviz keeps the execution trace only for this span: GMP replay and goroutine diagnosis work inside it">trace kept for replay <span class="mono">{ vm.Replayable }</span></span>
		}
		<span class="faint">hover a chart to compare the same time · drag to zoom</span>
	</div>
	@sectionTitle("Status", "now, regardless of the range")
	<div class="grid-even">
		<section class="panel">
			<h2>Open issues</h2>
			<a class="stat" href="/issues">
				<div class={ "value", templ.KV("error", vm.IssueCount > 0) }>{ strconv.Itoa(vm.IssueCount) }</div>
				<div class="label">open issues</div>
			</a>
			if len(vm.Issues) > 0 {
				<table class="overview-issues">
					for _, i := range vm.Issues {
						<tr>
							<td><span class="badge kind">{ i.Kind }</span></td>
							<td class="origin"><a href={ templ.SafeURL(i.Href) } title={ i.Subject }>{ ShortPath(i.Subject) }</a><div class="muted">{ i.Summary }</div></td>
							<td class="num faint">{ i.Age }</td>
						</tr>
					}
				</table>
				if vm.IssueCount > len(vm.Issues) {
					<p><a href="/issues">all { strconv.Itoa(vm.IssueCount) } issues →</a></p>
				}
			}
		</section>
		<section class="panel">
			<h2>Goroutines</h2>
			if vm.HasSnapshot {
				<div class="stat">
					<div class="value">{ strconv.Itoa(vm.GoroutinesNow) }</div>
					<div class="label">in the latest dump (<span class="mono">{ vm.DumpAt }</span>)</div>
				</div>
				<div class="legend now">
					for _, s := range vm.States {
						<span><i class={ s.Class }></i>{ s.Label } <span class="mono">{ strconv.Itoa(s.Count) }</span></span>
					}
				</div>
				<p class="faint footnote"><span title="GOMAXPROCS: how many goroutines can run at the same time">P (CPU slots) <span class="mono">{ strconv.Itoa(vm.Procs) }</span></span> · runtime leak check { vm.LeakCheck }</p>
			} else {
				<p class="muted">no goroutine dump yet</p>
			}
		</section>
	</div>
	@sectionTitle("Goroutines", "how many there were and where they were created")
	<div class="grid-wide">
		<section class="panel">
			<h2 title="average of the dumps in each point · no bar = no dump">By state</h2>
			@chart(vm.Goroutines, "no goroutine dump in this range")
		</section>
		<section class="panel">
			<h2 title="hover the chart to see the origins at that time">Top origins <span class="muted">where the goroutines were created</span></h2>
			<table class="origins">
				<tr><th class="num">now</th><th class="num">max in range</th><th>created by</th></tr>
				for _, o := range vm.Origins {
					<tr>
						<td class="num mono">
							if o.HasNow {
								{ strconv.Itoa(o.Now) }
							} else {
								<span class="faint">-</span>
							}
						</td>
						<td class="num mono">
							if o.HasMax {
								{ strconv.Itoa(o.Max) }
							} else {
								<span class="faint">-</span>
							}
						</td>
						<td class="origin" title={ o.Origin }>{ ShortPath(o.Origin) }</td>
					</tr>
				}
			</table>
		</section>
	</div>
	@sectionTitle("Memory & GC", "whether the heap keeps growing and how much time the GC takes")
	<div class="grid-3">
		<section class="panel">
			<h2 title="live heap = what survived the last GC; keeps rising = retained memory grows. heap goal ≈ live heap × (1 + GOGC/100), lower if GOMEMLIMIT caps it. heap objects = live + garbage not yet freed">
				Heap
				if vm.EffectiveGOGC != "" {
					<span class="muted">effective GOGC ≈ <span class="mono">{ vm.EffectiveGOGC }</span></span>
				}
			</h2>
			@chart(vm.Heap, "no trace in this range")
		</section>
		<section class="panel">
			<h2 title="high with a flat live heap = many short-lived allocations. raising GOGC trades memory for fewer cycles">GC <span class="muted">cycles / s</span></h2>
			@chart(vm.GC, "no trace in this range")
		</section>
		<section class="panel">
			<h2 title="time goroutines were made to help the GC instead of running, per second. it adds to the latency of those goroutines">Mark assist <span class="muted">ms / s</span></h2>
			@chart(vm.MarkAssist, "no trace in this range")
		</section>
	</div>
	@sectionTitle("CPU", "whether there are enough P for the goroutines ready to run")
	<section class="panel">
		<h2 title="how many goroutines were ready to run but waiting for a P (CPU), averaged over time: 0.5 = one goroutine was waiting half of the time. rising with the latency = CPU is short">Waiting for P <span class="muted">goroutines waiting at a time, on average</span></h2>
		@chart(vm.CPUWaiting, "no trace in this range")
	</section>
}

templ sectionTitle(title, desc string) {
	<h3 class="section-title">{ title } <span>{ desc }</span></h3>
}

templ chart(vm ChartViewModel, empty string) {
	<div class="chart" data-chart-kind={ vm.Kind } data-chart-readout={ vm.Readout } data-chart-notes={ vm.Notes }>
		if len(vm.Legend) > 1 || vm.ThresholdLabel != "" {
			<div class="legend">
				if len(vm.Legend) > 1 {
					for _, l := range vm.Legend {
						<span><i class={ l.Class }></i>{ l.Label }</span>
					}
				}
				if vm.ThresholdLabel != "" {
					<span><i class="threshold"></i>{ vm.ThresholdLabel }</span>
				}
			</div>
		}
		<div class="chart-body">
			<div class="chart-y mono">
				for _, t := range vm.YTicks {
					<span style={ templ.SafeCSS("bottom:" + t.Pos) }>{ t.Text }</span>
				}
			</div>
			<div class="chart-plot">
				if vm.NoData != "" {
					<div class="chart-nodata" style={ templ.SafeCSS("width:" + vm.NoData) }><span>no data</span></div>
				}
				<svg viewBox="0 0 1000 160" preserveAspectRatio="none">
					for _, y := range vm.GridY {
						<line class="chart-grid" x1="0" y1={ y } x2="1000" y2={ y }></line>
					}
					for _, x := range vm.GridX {
						<line class="chart-grid" x1={ x } y1="0" x2={ x } y2="160"></line>
					}
					<line class="chart-baseline" x1="0" y1="160" x2="1000" y2="160"></line>
					if vm.ThresholdY != "" {
						<line class="chart-threshold" x1="0" y1={ vm.ThresholdY } x2="1000" y2={ vm.ThresholdY }></line>
					}
					for _, b := range vm.Bars {
						<rect class={ "bar", b.Class } x={ b.X } y={ b.Y } width={ b.W } height={ b.H }></rect>
					}
					for _, l := range vm.Lines {
						<path class={ "line", l.Class } d={ l.D }></path>
					}
				</svg>
				if vm.Empty && vm.NoData != "100%" {
					<div class="chart-empty muted">{ empty }</div>
				}
			</div>
		</div>
		<div class="chart-x mono">
			for _, x := range vm.XLabels {
				<span style={ templ.SafeCSS("left:" + x.Pos) }>{ x.Text }</span>
			}
		</div>
	</div>
}
