package components

// BreakdownViewModel は状態別の時間内訳の帯。Segments は主因の順
type BreakdownViewModel struct {
	Segments   []BreakdownSegmentViewModel
	Unrecorded string
}

type BreakdownSegmentViewModel struct {
	Cause    string
	Percent  string
	Duration string
}

templ Breakdown(vm BreakdownViewModel) {
	<div class="breakdown-bar" role="img" aria-label="time by state">
		for _, s := range vm.Segments {
			<span class={ "cause-bg-" + s.Cause } style={ "width:" + s.Percent } title={ s.Cause + " " + s.Duration + " (" + s.Percent + ")" }></span>
		}
	</div>
	<table class="breakdown-table">
		<tbody>
			for _, s := range vm.Segments {
				<tr>
					<td>@CauseBadge(s.Cause)</td>
					<td class="num mono">{ s.Duration }</td>
					<td class="num mono muted">{ s.Percent }</td>
				</tr>
			}
			if vm.Unrecorded != "" {
				<tr>
					<td class="muted" title="time in the period when the goroutine did not exist or had no recorded state">not recorded</td>
					<td class="num mono muted">{ vm.Unrecorded }</td>
					<td></td>
				</tr>
			}
		</tbody>
	</table>
}
