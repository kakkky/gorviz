package components

// CertaintyBadge は診断の確かさ (FACT / INFERENCE) のバッジ
templ CertaintyBadge(certainty string) {
	if certainty == "FACT" {
		<span class="badge fact" title="read directly from the runtime's judgement or the recorded trace / dump">FACT</span>
	} else {
		<span class="badge inference" title="inferred by gorviz from trends, comparison or timestamps">INFERENCE</span>
	}
}
