package components

// SearchFormViewModel は一覧の上の検索欄。Selects・Inputs は文字列の検索欄の後ろに並べる絞り込み
type SearchFormViewModel struct {
	Action      string
	Query       string
	Placeholder string
	Selects     []SearchSelectViewModel
	Inputs      []SearchInputViewModel
	Keep        []KeptParamViewModel
}

type SearchSelectViewModel struct {
	Name     string
	All      string
	Options  []SearchOptionViewModel
	Selected string
}

type SearchOptionViewModel struct {
	Value string
	Label string
}

type SearchInputViewModel struct {
	Name        string
	Value       string
	Placeholder string
	Title       string
}

templ SearchForm(vm SearchFormViewModel) {
	<section class="panel search-card">
		<form method="get" action={ templ.SafeURL(vm.Action) } class="search-form">
			for _, k := range vm.Keep {
				<input type="hidden" name={ k.Name } value={ k.Value }/>
			}
			<input type="search" name="q" value={ vm.Query } placeholder={ vm.Placeholder }/>
			for _, in := range vm.Inputs {
				<input type="search" class="narrow-input" name={ in.Name } value={ in.Value } placeholder={ in.Placeholder } title={ in.Title }/>
			}
			for _, s := range vm.Selects {
				<select name={ s.Name }>
					<option value="">{ s.All }</option>
					for _, o := range s.Options {
						<option value={ o.Value } selected?={ o.Value == s.Selected }>{ o.Label }</option>
					}
				</select>
			}
			<button type="submit" class="primary">Search</button>
		</form>
	</section>
}
