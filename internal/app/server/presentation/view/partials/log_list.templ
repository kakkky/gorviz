package partials

import (
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
)

const (
	LogListID            = "log-list"
	LogsStreamSourceID   = "logs-stream-source"
	LogsRangeID          = "logs-range"
)

// LogsStreamUpdate は今に合わせて動く期間の一覧と、見出しの範囲を書き換える。一覧は変わったところだけ (morph)、スクロールした位置や hover を保つ
templ LogsStreamUpdate(vm components.LogListViewModel, rg components.TimeRangeViewModel) {
	@turbo.StreamUpdate(LogListID, turbo.AttrMethodMorph()) {
		@components.LogList(vm)
	}
	@turbo.StreamUpdate(LogsRangeID) {
		@components.TimeRangeBody(rg)
	}
}
