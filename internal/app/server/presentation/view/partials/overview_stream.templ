package partials

import (
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
)

const (
	OverviewStreamSourceID = "overview-stream-source"
	OverviewID             = "overview"
	OverviewRangeID        = "overview-range"
)

// OverviewStreamUpdate は変わったところだけを書き換える (morph)。丸ごと入れ替えると、hover している要素が refresh ごとに消えて説明 (title) が出ない
templ OverviewStreamUpdate(vm components.OverviewViewModel) {
	@turbo.StreamUpdate(OverviewID, turbo.AttrMethodMorph()) {
		@components.OverviewSnapshot(vm)
	}
	@turbo.StreamUpdate(OverviewRangeID) {
		@components.TimeRangeBody(vm.Range)
	}
}
