package partials

import (
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
)

// LogDetailFrame は Logs の行を開いたときに差し替える turbo-frame の id
const LogDetailFrame = "log-detail"

// LogDetailViewModel は開いたログ 1 行。Open が false なら何も開いていない
type LogDetailViewModel struct {
	Open        bool
	At          string
	TimeNote    string
	Instance    string
	Level       string
	Message     string
	Duration    string
	Source      string
	Attrs       []KeyValueViewModel
	Raw         string
	Period      string
	PeriodNote  string
	Writer      LogWriterViewModel
	Preserved   []components.LinkItemViewModel
	CloseURL    string
}

type KeyValueViewModel struct {
	Key   string
	Value string
}

// LogWriterViewModel は書いた goroutine。URL はその Goroutine、分からなければ SchedulerURL (その時刻の Scheduler) へ移る
type LogWriterViewModel struct {
	Found         bool
	Goroutine     string
	Certainty     string
	CertaintyNote string
	URL           string
	SchedulerURL  string
	Unavailable   *components.UnavailableViewModel
	Note          string
}

templ LogDetail(vm LogDetailViewModel) {
	@turbo.Frame(LogDetailFrame) {
		if vm.Open {
			<div class="panel log-detail">
				<div class="detail-head">
					<span class={ "level", "level-" + vm.Level }>{ vm.Level }</span>
					<span class="mono">{ vm.At }</span>
					<span class="mono muted">{ vm.Instance }</span>
					<a class="close" href={ templ.SafeURL(vm.CloseURL) } data-turbo-frame="_top" title="close">×</a>
				</div>
				<p class="message">{ vm.Message }</p>
				if vm.TimeNote != "" {
					<p class="faint small">{ vm.TimeNote }</p>
				}
				<h3>Written by</h3>
				<div class="writer">
					if vm.Writer.Found {
						<a class="btn primary" href={ templ.SafeURL(vm.Writer.URL) } data-turbo-frame="_top">{ vm.Writer.Goroutine } · open Goroutine</a>
						@components.CertaintyBadge(vm.Writer.Certainty, vm.Writer.CertaintyNote)
						<span class="faint small">{ vm.Writer.CertaintyNote }</span>
					} else {
						if vm.Writer.Unavailable != nil {
							@components.Unavailable(*vm.Writer.Unavailable)
						}
						if vm.Writer.Note != "" {
							<p class="muted">{ vm.Writer.Note }</p>
						}
						<a class="btn" href={ templ.SafeURL(vm.Writer.SchedulerURL) } data-turbo-frame="_top">Replay the scheduler at that time</a>
					}
				</div>
				<p class="faint small">period to look at: <span class="mono">{ vm.Period }</span> · { vm.PeriodNote }</p>
				if len(vm.Preserved) > 0 {
					<h3>Execution traces kept around this error</h3>
					@components.LinkList(vm.Preserved)
				}
				<h3>Fields</h3>
				if len(vm.Attrs) == 0 {
					<p class="faint">not a JSON line</p>
				} else {
					<table class="kv">
						<tbody>
							for _, a := range vm.Attrs {
								<tr><th class="mono">{ a.Key }</th><td class="mono wrap">{ a.Value }</td></tr>
							}
						</tbody>
					</table>
				}
				<h3>As logged <span class="faint">{ vm.Source }</span></h3>
				<pre class="raw">{ vm.Raw }</pre>
			</div>
		}
	}
}
