package partials

import (
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
)

// 最新の窓の SSE は Scheduler と Goroutine の画面で共通。再生のデータの所 (ReplayDataID) に入り、範囲は ReplayRangeID に再生の controller が書く
const (
	ReplayStreamSourceID = "replay-stream-source"
	ReplayDataID         = "replay-data"
	ReplayRangeID        = "replay-range"
)

// ReplayStreamUpdate は最新の窓を再生のデータの所に入れる。追うのをやめた再生は、届いても読まない (gmp_replay_controller.js)
templ ReplayStreamUpdate(json string) {
	@turbo.StreamUpdate(ReplayDataID) {
		@components.GMPReplayData(json)
	}
}
