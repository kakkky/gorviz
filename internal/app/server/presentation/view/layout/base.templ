package layout

import (
	"github.com/kakkky/hotwire-go/stimulus"
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/assets"
	"github.com/kakkky/gorviz/internal/app/server/presentation/view/components"
)

// NavItems はナビゲーションに並べる画面。Goroutine は他の画面から降りてくる画面なので置かない
var NavItems = []struct{ Label, Href string }{
	{"Overview", "/"},
	{"Issues", "/issues"},
	{"Logs", "/logs"},
	{"Scheduler", "/scheduler"},
}

// Base の active はナビゲーションで強調する画面の Label。
// import map は Turbo で画面を移ったあとには足せないので、どの画面でもすべての controller を読み込んでおく
templ Base(targetURL string, active string) {
	<!DOCTYPE html>
	<html lang="ja">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>gorviz</title>
			// 版が変わったら (作り直したら)、Turbo が画面ごと読み直して新しい CSS と JS (import map) を使う
			<link rel="stylesheet" href={ assets.Versioned("/assets/main.css") } data-turbo-track="reload"/>
			// 一部の古いブラウザは module の読み込み開始後に出た import map を無視するので、Turbo の module より先に import map を出す
			@stimulus.ScriptLoad(assets.Versioned(assets.GMPReplayController.Path), assets.Versioned(assets.ChartSyncController.Path), assets.Versioned(assets.RowLinkController.Path), assets.Versioned(assets.KeepScrollController.Path), assets.Versioned(assets.TimeRangePickerController.Path), assets.Versioned(assets.RowDetailController.Path))
			@turbo.ScriptImport()
		</head>
		<body>
			<header class="app">
				<h1>gorviz</h1>
				// 見ている対象 (service とインスタンス) の切り替え。中身は agent の一覧を持つ入口から読み込む
				@components.AgentMenuFrame(targetURL)
				<nav>
					for _, item := range NavItems {
						<a href={ templ.SafeURL(item.Href) } class={ templ.KV("active", item.Label == active) }>{ item.Label }</a>
					}
				</nav>
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}
