package layout

import (
	"github.com/kakkky/hotwire-go/stimulus"
	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/gorviz/internal/app/server/assets"
)

// BaseViewModel は全画面の外枠。見出しのピルは見ているサービスとインスタンスで、開くとサービスごとのインスタンスを並べる
type BaseViewModel struct {
	Title    string
	Service  string
	Instance string
	Running  bool
	Groups   []ServiceGroupViewModel
	Tabs     []LinkViewModel
}

type ServiceGroupViewModel struct {
	Name      string
	URL       string
	Current   bool
	Instances []InstanceLinkViewModel
}

type LinkViewModel struct {
	Label  string
	URL    string
	Active bool
}

type InstanceLinkViewModel struct {
	Label   string
	URL     string
	Active  bool
	Running bool
	State   string
}

func controllerPaths() []string {
	out := make([]string, 0, len(assets.Controllers))
	for _, c := range assets.Controllers {
		out = append(out, assets.Versioned(c.Path))
	}
	return out
}

templ head(title string) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title } · gorviz</title>
		<link rel="stylesheet" href={ assets.Versioned(assets.StylesheetPath) } data-turbo-track="reload"/>
		// 古いブラウザは module の読み込み開始後に出た import map を無視するので、import map (ScriptLoad) を module より先に出す
		@stimulus.ScriptLoad(controllerPaths()...)
		<script type="module" src={ assets.Versioned(assets.IslandsPath) } data-turbo-track="reload"></script>
		@turbo.ScriptImport()
	</head>
}

templ Base(vm BaseViewModel) {
	<!DOCTYPE html>
	<html lang="ja">
		@head(vm.Title)
		<body>
			<header class="app">
				<h1><a href="/">gorviz</a></h1>
				<details class="trp agent-menu" { stimulus.AttrControllers(assets.TimeRangePickerController.Name)... }>
					<summary class="agent-switch" title="switch the service and instance to look at">
						<span class={ "agent-dot", templ.KV("connected", vm.Running) }></span>
						<strong>{ vm.Service }</strong>
						if vm.Instance != "" {
							<span class="sep">·</span>
							<span class="mono">{ vm.Instance }</span>
						}
						<span class="trp-caret" aria-hidden="true"></span>
					</summary>
					<div class="trp-pop agent-pop">
						for _, g := range vm.Groups {
							<div class="agent-group">
								<a class={ "agent-group-head", templ.KV("current", g.Current) } href={ templ.SafeURL(g.URL) }>{ g.Name }</a>
								for _, i := range g.Instances {
									<a class={ "agent-item", templ.KV("current", i.Active) } href={ templ.SafeURL(i.URL) }>
										<span class={ "agent-dot", templ.KV("connected", i.Running) }></span>
										<span class="mono">{ i.Label }</span>
										<span class="faint">{ i.State }</span>
									</a>
								}
							</div>
						}
					</div>
				</details>
				<nav>
					for _, t := range vm.Tabs {
						<a href={ templ.SafeURL(t.URL) } class={ templ.KV("active", t.Active) }>{ t.Label }</a>
					}
				</nav>
				<form method="post" action="/logout" class="logout" data-turbo="false">
					<button type="submit" class="logout-button" title="log out">Log out</button>
				</form>
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

// Bare はサービスを選ぶ前の画面 (ログイン・サービスがまだないとき) の外枠
templ Bare(title string) {
	<!DOCTYPE html>
	<html lang="ja">
		@head(title)
		<body class="bare">
			<header class="app">
				<h1>gorviz</h1>
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}
